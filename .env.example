# =============================================================================
# TRIPLE E ORGANIZATION 2ND QUIZ COMPETITION RESULT PORTAL
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.local)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. INITIAL ADMINISTRATOR BOOTSTRAP CREDENTIALS (Server-Side Only)
# -----------------------------------------------------------------------------
# The server-side bootstrap process reads these credentials on first run and
# generates a salted bcrypt hash (cost factor 12) stored in src/data/admin-auth.json.
# The initial password is NEVER stored in plaintext.
# The admin is strictly required to change this password before production use.
INITIAL_ADMIN_EMAIL="khapluali19@gmail.com"
INITIAL_ADMIN_PASSWORD="ali12345"

# Secret token required for admin configuration and sync API endpoints
ADMIN_ACCESS_SECRET="triple-e-secret-key-2026"

# -----------------------------------------------------------------------------
# 2. GOOGLE CLOUD SERVICE ACCOUNT CREDENTIALS (Server-Side Only)
# -----------------------------------------------------------------------------
# To connect private Google Spreadsheets without making them public to the web:
# 1. Go to Google Cloud Console (https://console.cloud.google.com).
# 2. Create a project and enable "Google Sheets API".
# 3. Create a Service Account (e.g. triple-e-sync@<project-id>.iam.gserviceaccount.com).
# 4. Generate and download a JSON keyfile.
# 5. Share your private Google Sheets with the service account email as "Viewer".
# 6. Paste the client email and private key below:
GOOGLE_SERVICE_ACCOUNT_EMAIL="triple-e-sheets-sync@triple-e-org.iam.gserviceaccount.com"

# The private key from your service account JSON keyfile.
# Note: Ensure newline characters are written as \n if entered as a single-line string.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional fallback: Google Sheets API Key (only valid for publicly published sheets)
GOOGLE_API_KEY=""

# -----------------------------------------------------------------------------
# 3. PUBLIC WEBSITE CONFIGURATION
# -----------------------------------------------------------------------------
# Canonical URL for OpenGraph metadata resolution and link generation
NEXT_PUBLIC_SITE_URL="https://results.triple-e.org"
